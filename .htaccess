# Root rules. Text compression is already done by the server, so none here.
# edit/ has its own .htaccess (basic auth) and is not touched.

# Files and folders that are not part of the site (the server pulls the whole repo)
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(docs|tools|\.claude|\.git|\.github|\.superpowers|node_modules)(/|$)
    RedirectMatch 404 ^/(.*\.md|LICENSE|links\.default\.json|package(-lock)?\.json|\.gitignore)$
    # the data lives in edit/ (behind the sign-in); stray copies in the root must not be readable
    RedirectMatch 404 ^/(links\.json|[^/]+\.bak\.json)$
</IfModule>

# Caching. The page is revalidated every time; CSS/JS and never-dead.json for an hour (?v= busts them on the day-end bump);
# icons for a week; fonts, which never change under the same name, for a year.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js)$|^never-dead\.json$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.(png|ico|svg|webmanifest)$|^manifest\.json$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
